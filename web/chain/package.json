{
  "name": "terra-contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node --network hardhat",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:base": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:directory": "hardhat run scripts/deploy-directory.ts",
    "deploy:community": "hardhat run scripts/deploy-community.ts",
    "verify:deployment": "hardhat run scripts/verify.ts",
    "deployer:create": "node scripts/deployer.mjs create",
    "deployer:status": "node scripts/deployer.mjs status",
    "operator:create": "node scripts/operator.mjs create",
    "operator:status": "node scripts/operator.mjs status",
    "agent": "node scripts/agent.mjs",
    "smoke:local": "node scripts/smoke-local.mjs"
  },
  "devDependencies": {
    "hardhat": "3.19.0",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "viem": "2.57.4",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "tsx": "4.23.15"
  }
}
